# Auth Service — Environment Variables
# Copy this to .env and fill in your values.

# Server
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
BASE_URL=http://localhost:8080
APP_NAME=Fusion Platform

# Database
DATABASE_URL=postgres://fusion:fusion@localhost:5432/fusion?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=fusion:auth:

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_SECRET=change-this-to-another-long-random-string

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# OAuth — Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URL=http://localhost:8080/api/v1/auth/twitch/callback

# OTP
OTP_DEFAULT_TTL=10m
OTP_MAX_ATTEMPTS=3
OTP_MAX_PER_HOUR=5
OTP_RESEND_COOLDOWN=60s

# Email
EMAIL_PROVIDER=console   # "console" for dev, "resend" for production
RESEND_API_KEY=
FROM_EMAIL=noreply@fusionplatform.com
FROM_NAME=Fusion Platform